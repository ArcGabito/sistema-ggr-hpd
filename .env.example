# =====================================================================
#  Sistema de Gestión de Guías de Remisión — HPD Glass Group S.A.C.
#  Copia este archivo a .env (scripts/setup.sh y scripts/run.sh lo
#  hacen por ti y generan secretos aleatorios).
# =====================================================================

# ---------- General ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Puertos expuestos en el host ----------
CLIENT_PORT=3000
SERVER_PORT=5040
DATABASE_PORT=1433

# ---------- Base de datos (SQL Server para desarrollo) ----------
# La contraseña debe tener 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
# No uses ';' ni '$' (rompen la cadena de conexión / interpolación de compose).
DB_NAME=HpdGgr
DB_SA_PASSWORD=Cambia_Esta_Clave_123!
MSSQL_PID=Developer

# ---------- Autenticación JWT ----------
# Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_ISSUER=hpd-ggr-server
JWT_AUDIENCE=hpd-ggr-client
JWT_EXPIRATION_MINUTES=480

# ---------- Usuario administrador inicial ----------
SEED_ADMIN_NAME=Administrador HPD
SEED_ADMIN_EMAIL=admin@hpdglass.com
SEED_ADMIN_PASSWORD=Cambia_Esta_Clave_456!

# ---------- Datos de demostración (solo desarrollo) ----------
# true llena una base vacía con guías, despachos, solicitudes, usuarios y artículos de ejemplo.
# Usuarios demo: supervisor.demo@hpdglass.com y operador.demo@hpdglass.com (contraseña abajo).
# Déjalo en false en producción.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Cambia_Esta_Clave_789!

# ---------- Correo (envío de guías de remisión) ----------
# En desarrollo los correos llegan a Mailpit: http://localhost:8025
# En producción usa tu SMTP (p. ej. SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURITY=StartTls).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@hpdglass.com
SMTP_FROM_NAME=HPD Glass Group
MAILPIT_PORT=8025

# ---------- Cliente Next.js ----------
# URL pública del sitio, usada en Open Graph, el sitemap y la URL canónica (sin "/" final).
# Se aplica al construir la imagen del cliente: tras cambiarla, reconstruye con ./scripts/run.sh
SITE_URL=http://localhost:3000
# En Docker el cliente llega al backend por la red interna (http://server:8080).
# Para `npm run dev` fuera de Docker usa API_URL=http://localhost:5040 en core/client/.env.local
API_URL=http://server:8080
# true solo cuando el sitio se sirva por HTTPS.
COOKIE_SECURE=false
